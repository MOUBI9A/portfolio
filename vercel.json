{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/resume/?", "dest": "/resume/index.html" },
    { "src": "/work/(carhub|creator-revenue-os|leadforge|noor|labgenz)/?", "dest": "/work/$1/index.html" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
